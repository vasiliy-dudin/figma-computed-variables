{
  "name": "figma-computed-variables",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "run-s dev",
    "dev": "run-s watch",
    "dev:ui-only": "vite -c ./vite.config.ui.ts",
    "watch": "run-p watch:*",
    "watch:ui": "npm run build:ui -- --watch --mode=development",
    "watch:plugin": "npm run build:plugin -- --watch --mode=development",
    "clean": "rimraf dist",
    "types": "run-s types:*",
    "types:src": "tsc",
    "types:node": "tsc -P tsconfig.node.json",
    "build": "run-s build:*",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "run-s types clean",
    "build:ui": "vite build -c ./vite.config.ui.ts",
    "build:plugin": "vite build -c ./vite.config.plugin.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "@figma/plugin-typings": "^1.123.0",
    "@types/node": "^25.5.0",
    "@types/postcss-url": "^10.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "codemirror": "^6.0.2",
    "culori": "^4.0.2",
    "monorepo-networker": "^2.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.8",
    "postcss-url": "^10.1.3",
    "preact": "^10.29.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-generate-file": "^0.3.1",
    "vite-plugin-react-rich-svg": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
