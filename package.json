{
  "name": "figma-computed-variables",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p watch:*",
    "prebuild": "tsc && tsc -P tsconfig.node.json && rimraf dist",
    "build": "run-s _build:ui _build:plugin",
    "test": "vitest run",
    "test:watch": "vitest",
    "_watch:ui": "vite build -c ./vite.config.ui.ts --watch --mode=development",
    "_watch:plugin": "vite build -c ./vite.config.plugin.ts --watch --mode=development",
    "_build:ui": "vite build -c ./vite.config.ui.ts",
    "_build:plugin": "vite build -c ./vite.config.plugin.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.0",
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "@figma/plugin-typings": "^1.125.0",
    "@types/node": "^25.6.0",
    "@types/postcss-url": "^10.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "codemirror": "^6.0.2",
    "culori": "^4.0.2",
    "monorepo-networker": "^2.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.14",
    "postcss-url": "^10.1.3",
    "preact": "^10.29.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-generate-file": "^0.3.1",
    "vite-plugin-react-rich-svg": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
